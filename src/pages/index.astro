---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>YaPB — The Counter-Strike Bot</title>
    <meta
      name="description"
      content="YaPB is an open-source bot for Counter-Strike 1.6 and Condition Zero. Download the latest release, grab waypoints, read the docs."
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://yapb.github.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YaPB" />
    <meta property="og:url" content="https://yapb.github.io/" />
    <meta property="og:title" id="ogTitle" content="YaPB — The Counter-Strike Bot" />
    <meta property="og:description" id="ogDesc" content="YaPB is an open-source bot for Counter-Strike 1.6 and Condition Zero. Download the latest release, grab waypoints, read the docs." />
    <meta property="og:image" content="https://yapb.github.io/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YaPB — The Counter-Strike Bot" />
    <meta property="og:locale" id="ogLocale" content="en_US" />
    <meta property="og:locale:alternate" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" id="twTitle" content="YaPB — The Counter-Strike Bot" />
    <meta name="twitter:description" id="twDesc" content="YaPB is an open-source bot for Counter-Strike 1.6 and Condition Zero. Download the latest release, grab waypoints, read the docs." />
    <meta name="twitter:image" content="https://yapb.github.io/og.png" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "YaPB",
      "applicationCategory": "GameApplication",
      "operatingSystem": ["Windows", "Linux"],
      "description": "YaPB is an open-source bot for Counter-Strike 1.6 and Condition Zero.",
      "url": "https://yapb.github.io/",
      "downloadUrl": "https://github.com/yapb/yapb/releases",
      "codeRepository": "https://github.com/yapb/yapb",
      "license": "https://unlicense.org/",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Organization", "name": "YaPB Team" }
    }
    </script>
    <meta name="theme-color" content="#080a0d" id="themeColor" />
    <script is:inline>
      try {
        const t = localStorage.getItem('yapb-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        else if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #080a0d;
        --panel: #0e1218;
        --line: rgba(255, 255, 255, 0.09);
        --text: #f2f4f7;
        --muted: #a8a29e;
        --accent: #ffb454;
        --accent-hover: #ffc37a;
        --accent-ink: #14100a;
        --soft: rgba(255, 255, 255, 0.03);
        --hover: rgba(255, 255, 255, 0.06);
        --grid: rgba(255, 255, 255, 0.075);
        --header-bg: rgba(8, 10, 13, 0.72);
        --menu-bg: rgba(14, 18, 24, 0.98);
        --overlay: rgba(0, 0, 0, 0.65);
      }
      [data-theme="light"] {
        color-scheme: light;
        --bg: #f4f1ea;
        --panel: #ffffff;
        --line: rgba(23, 20, 12, 0.14);
        --text: #1c1913;
        --muted: #6f675c;
        --accent: #c27000;
        --accent-hover: #a35c00;
        --accent-ink: #fff8ec;
        --soft: rgba(23, 20, 12, 0.04);
        --hover: rgba(23, 20, 12, 0.07);
        --grid: rgba(23, 20, 12, 0.07);
        --header-bg: rgba(244, 241, 234, 0.82);
        --menu-bg: rgba(255, 255, 255, 0.98);
        --overlay: rgba(28, 25, 19, 0.45);
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        color: var(--text);
        background:
          radial-gradient(700px 500px at 85% 110%, rgba(255, 180, 84, 0.11), transparent 60%),
          var(--bg);
        min-height: 100svh;
        display: flex;
        flex-direction: column;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(var(--grid) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: radial-gradient(700px 420px at 50% 30%, black 30%, transparent 75%);
      }
      .side {
        position: fixed;
        top: 0;
        height: 100svh;
        width: min(320px, 24vw);
        z-index: 0;
        pointer-events: none;
      }
      .side-l { left: 0; }
      .side-r { right: 0; }
      @media (max-width: 1150px) {
        .side { width: min(200px, 20vw); opacity: 0.6; }
      }
      @media (max-width: 820px) { .side { display: none; } }
      a:link, a:visited { color: var(--text); text-decoration: none; }
      .links a:link, .links a:visited { color: var(--muted); }
      .links a:hover { color: var(--accent); background: var(--hover); border-color: var(--accent); }
      .wrap {
        width: min(1060px, calc(100% - 40px));
        margin-inline: auto;
      }
      /* nav */
      header {
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--header-bg);
      }
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 74px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-decoration: none;
        font-size: 24px;
      }
      .brand-mark {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        overflow: hidden;
        flex-shrink: 0;
      }
      .brand-mark img { width: 100%; height: 100%; display: block; }
      .links {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .theme-btn {
        border: 1px solid var(--line);
        background: transparent;
        color: var(--muted);
        border-radius: 8px;
        padding: 8px 10px;
        cursor: pointer;
        font-size: 14px;
        line-height: 1;
        margin-left: 6px;
      }
      .theme-btn:hover { color: var(--accent); border-color: var(--accent); }
      .lang {
        display: inline-flex;
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
        margin-left: 6px;
      }
      .lang-btn {
        background: transparent;
        border: none;
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        letter-spacing: 0.06em;
        padding: 8px 9px;
        cursor: pointer;
      }
      .lang-btn.active { background: var(--accent); color: var(--accent-ink); font-weight: 800; }
      .navdrop { position: relative; }
      .navdrop-btn {
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        color: var(--muted);
        background: transparent;
        padding: 8px 12px;
        border-radius: 8px;
        border: 1px solid var(--line);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .navdrop-btn:hover { color: var(--accent); background: var(--hover); border-color: var(--accent); }
      .navdrop-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 230px;
        background: var(--menu-bg);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 6px;
        z-index: 30;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
      }
      .navdrop-menu[hidden] { display: none; }
      .navdrop-menu a:link, .navdrop-menu a:visited { border: none; }
      .navdrop-menu a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: none;
      }
      .navdrop-menu a:hover { border: none; }
      .nd-host { font-size: 11px; letter-spacing: 0; text-transform: none; color: var(--muted); }
      .nd-off {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 13px;
        color: var(--muted);
        opacity: 0.45;
        cursor: not-allowed;
        user-select: none;
      }
      .nd-soon {
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 2px 8px;
      }
      .links a {
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 8px;
        border: 1px solid var(--line);
      }
      .links a:hover { color: var(--accent); background: var(--hover); border-color: var(--accent); }
      /* hero */
      main { flex: 1; display: flex; align-items: center; position: relative; z-index: 1; }
      .hero {
        text-align: center;
        padding: 84px 0 72px;
        position: relative;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        border: 1px solid var(--line);
        background: var(--soft);
        padding: 8px 14px;
        border-radius: 999px;
      }
      .dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #7ee787;
        box-shadow: 0 0 10px #7ee787;
      }
      h1 {
        margin: 26px 0 0;
        font-size: clamp(64px, 13vw, 148px);
        line-height: 0.9;
        letter-spacing: -0.04em;
        font-weight: 900;
      }
      h1 span { color: var(--accent); }
      .sub {
        margin: 18px 0 0;
        font-size: clamp(16px, 2.6vw, 22px);
        color: var(--muted);
        letter-spacing: 0.02em;
      }
      .sub strong { color: var(--text); font-weight: 650; }
      .dl-count {
        margin: 28px 0 0;
        font-size: 13px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        min-height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .dl-count .stat,
      .dl-count a.stat {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        text-decoration: none;
      }
      .dl-count .sep { opacity: 0.5; margin-right: 2px; }
      .dl-count [hidden] { display: none !important; }
      #dlNum { color: var(--accent); font-weight: 800; }
      .cta {
        margin-top: 36px;
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        justify-content: center;
        text-decoration: none;
        font-weight: 750;
        font-size: 14px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 15px 26px;
        border-radius: 12px;
        border: 1px solid transparent;
        cursor: pointer;
        font-family: inherit;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      }
      .btn:active { transform: translateY(1px); }
      .btn-primary {
        background: var(--accent);
        color: var(--accent-ink);
        min-width: 250px;
      }
      .btn-primary:hover { background: var(--accent-hover); }
      .caret { font-size: 12px; opacity: 0.7; }
      /* download dropdown */
      .dl { position: relative; display: inline-block; }
      .dl-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        width: min(600px, 92vw);
        background: var(--menu-bg);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 14px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
        text-align: left;
        z-index: 30;
      }
      .dl-menu[hidden] { display: none; }
      .dl-group {
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 12px;
        background: var(--soft);
        min-width: 0;
      }
      .dl-group-title {
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 8px;
        flex-wrap: wrap;
      }
      .dl-group-title .ver { color: var(--accent); font-weight: 800; letter-spacing: 0.02em; }
      .pill {
        font-size: 10px;
        border: 1px solid rgba(255, 180, 84, 0.5);
        border-radius: 999px;
        padding: 2px 8px;
        color: var(--accent);
        letter-spacing: 0.1em;
      }
      .dl-items { display: flex; flex-direction: column; gap: 2px; }
      .dl-items a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 11px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
      }
      .dl-items a:link, .dl-items a:visited {
        color: var(--text);
      }
      .dl-items a:hover { background: var(--hover); color: var(--accent); }
      .dl-items a .sz { color: var(--muted); font-size: 12px; font-weight: 400; white-space: nowrap; }
      .dl-all:link, .dl-all:visited {
        grid-column: 1 / -1;
        text-align: center;
        font-size: 13px;
        color: var(--muted);
        text-decoration: none;
        padding: 8px;
        border-radius: 8px;
      }
      .dl-all:hover { color: var(--accent); background: var(--hover); }
      .dl-status {
        grid-column: 1 / -1;
        text-align: center;
        font-size: 11px;
        color: var(--muted);
        opacity: 0.8;
      }
      .btn-ghost {
        border: 1px solid var(--line);
        color: var(--text);
        background: var(--soft);
        min-width: 250px;
      }
      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
      .inst-menu {
        position: absolute;
        top: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        width: min(560px, 92vw);
        background: var(--menu-bg);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
        text-align: left;
        z-index: 30;
      }
      .inst-menu[hidden] { display: none; }
      .inst-menu .steps { gap: 10px; }
      .inst-menu .steps li { padding: 12px; }
      .steps { list-style: none; margin: 0 auto; padding: 0; max-width: 660px; display: flex; flex-direction: column; gap: 16px; }
      .steps li {
        display: grid;
        grid-template-columns: 52px 1fr;
        gap: 14px;
        align-items: start;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 18px;
        background: var(--soft);
      }
      .step-n { font-weight: 900; font-size: 18px; color: var(--accent); }
      .steps p { margin: 0; font-size: 14px; line-height: 1.6; }
      .steps p code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.88em;
        background: var(--hover);
        padding: 1px 7px;
        border-radius: 6px;
      }
      .steps a:link, .steps a:visited { color: var(--accent); text-decoration: none; }
      .steps a:hover { text-decoration: underline; }
      .codebox {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 12px;
        background: #0b0e13;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 10px 10px 10px 12px;
      }
      .codebox code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 12px;
        color: #f2f4f7;
        overflow-x: auto;
        white-space: nowrap;
      }
      .copybtn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.22);
        color: #f2f4f7;
        border-radius: 8px;
        padding: 6px 11px;
        cursor: pointer;
        font-size: 14px;
        flex-shrink: 0;
      }
      .copybtn:hover { color: var(--accent); border-color: var(--accent); }
      .note { margin-top: 10px !important; font-size: 13px !important; color: var(--muted) !important; }
      #dlStars:link, #dlStars:visited, #dlForks:link, #dlForks:visited { color: var(--muted); }
      #dlStars:hover, #dlForks:hover { color: var(--accent); }
      #starNum, #forkNum { color: var(--accent); font-weight: 800; }
      .stat-ico { width: 12px; height: 12px; vertical-align: -1px; }
      footer {
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 13px;
        position: relative;
        z-index: 1;
      }
      .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 0;
        flex-wrap: wrap;
      }
      .foot a:link, .foot a:visited { color: var(--muted); text-decoration: none; }
      .foot a:hover { color: var(--accent); }
      .foot-btn {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        color: var(--muted);
        cursor: pointer;
      }
      .foot-btn:hover { color: var(--accent); }
      .modal-note {
        font-size: 11.5px;
        line-height: 1.6;
        color: var(--muted);
        margin: 12px 0 0;
        padding-top: 12px;
        border-top: 1px solid var(--line);
      }
      .modal-note a:link, .modal-note a:visited { color: var(--muted); text-decoration: none; border-bottom: 1px dotted rgba(255,255,255,0.3); }
      .modal-note a:hover { color: var(--accent); }
      .modal { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 20px; }
      .modal[hidden] { display: none; }
      .modal-back { position: absolute; inset: 0; background: var(--overlay); }
      .modal-card {
        position: relative;
        width: min(580px, 100%);
        max-height: 82svh;
        display: flex;
        flex-direction: column;
        background: var(--menu-bg);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 20px 20px 16px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
        text-align: left;
      }
      .modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-size: 14px;
      }
      .modal-x {
        background: none;
        border: 1px solid var(--line);
        color: var(--muted);
        border-radius: 8px;
        width: 30px;
        height: 30px;
        cursor: pointer;
        font-size: 13px;
        line-height: 1;
      }
      .modal-x:hover { color: var(--accent); border-color: var(--accent); }
      .modal-sub { color: var(--muted); font-size: 13px; line-height: 1.6; margin: 12px 0 0; }
      .modal-body { overflow-y: auto; font-size: 13.5px; line-height: 1.7; margin-top: 12px; }
      .modal-body p { margin: 0 0 12px; }
      .modal-body p:last-child { margin-bottom: 0; }
      @media (max-width: 620px) {
        .dl-menu { grid-template-columns: 1fr; }
      }
      @media (max-width: 560px) {
        .links > a:not(:last-child) { display: none; }
        #inst { display: none; }
        .hero { padding: 56px 0 48px; }
        .brand { font-size: 20px; gap: 8px; }
        .brand-mark { width: 32px; height: 32px; }
        .navdrop-btn { padding: 8px 9px; }
        .lang { margin-left: 4px; }
        .lang-btn { padding: 8px 7px; }
        .theme-btn { padding: 8px; margin-left: 4px; }
        .dl-count { min-height: 40px; font-size: 12px; flex-direction: column; gap: 6px; }
        .dl-count .sep { display: none; }
        .dl-menu, .inst-menu {
          position: fixed;
          left: 50%;
          top: 50%;
          transform: translate(-50%, -50%);
          width: min(560px, calc(100vw - 32px));
          max-height: calc(100svh - 40px);
          overflow-y: auto;
        }
      }
    </style>
  </head>
  <body>
    <canvas class="side side-l" id="sideL" aria-hidden="true"></canvas>
    <canvas class="side side-r" id="sideR" aria-hidden="true"></canvas>
    <header>
      <div class="wrap nav">
        <a class="brand" href="/">
          <span class="brand-mark"><img src="/logo.png" width="38" height="38" alt="YaPB logo" /></span>
          YAPB
        </a>
        <nav class="links">
          <a href="https://yapb.github.io/docs/en" id="docsLink">Docs</a>
          <a href="https://github.com/yapb/graph">Graph</a>
          <div class="navdrop" id="codeDrop">
            <button class="navdrop-btn" id="codeBtn" aria-haspopup="true" aria-expanded="false">Code <span class="caret">▾</span></button>
            <div class="navdrop-menu" id="codeMenu" hidden>
              <a href="https://github.com/yapb/yapb" rel="noopener"><span>GitHub</span><span class="nd-host">github.com</span></a>
              <span class="nd-off"><span>SourceCraft</span><span class="nd-soon" data-i18n="soon">soon</span></span>
              <span class="nd-off"><span>Codeberg</span><span class="nd-soon" data-i18n="soon">soon</span></span>
            </div>
          </div>
          <span class="lang" role="group" aria-label="Language">
            <button class="lang-btn" data-lang="en">EN</button>
