          dlLoading: 'Загружаю версии с GitHub…',
          allReleases: 'Все релизы →',
          footerLeft: 'YaPB — бот для Counter-Strike с открытым кодом.',
          soon: 'скоро',
          disclaimer: 'Не связаны с Valve Corporation. Counter-Strike и Condition Zero — зарегистрированные товарные знаки Valve Corporation. Игра доступна в',
          title: 'YaPB — бот для Counter-Strike',
          metaDesc: 'YaPB — бот с открытым кодом для Counter-Strike 1.6 и Condition Zero. Скачайте последний релиз, заберите графы, почитайте доки.',
          themeLabel: 'Переключить тему',
