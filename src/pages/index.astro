      function applyLang(l) {
        if (!I18N[l]) l = 'en';
        window.yapbLang = l;
        const d = I18N[l];
        document.documentElement.lang = l;
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const k = el.getAttribute('data-i18n');
          if (d[k] === undefined) return;
          if (k === 'heroSub' || k === 'inst2') el.innerHTML = d[k];
          else el.textContent = d[k];
        });
        document.title = d.title;
        const md = document.querySelector('meta[name="description"]');
        if (md) md.setAttribute('content', d.metaDesc);
        const setMeta = (sel, val) => { const m = document.querySelector(sel); if (m) m.setAttribute('content', val); };
        setMeta('#ogTitle', d.title);
        setMeta('#ogDesc', d.metaDesc);
        setMeta('#twTitle', d.title);
        setMeta('#twDesc', d.metaDesc);
        setMeta('#ogLocale', l === 'ru' ? 'ru_RU' : 'en_US');
        document.getElementById('themeBtn').setAttribute('aria-label', d.themeLabel);
        document.getElementById('licClose').setAttribute('aria-label', d.closeLabel);
        document.getElementById('docsLink').href = d.docs;
        document.getElementById('instDocs').href = d.instDocsLink;
        document.getElementById('copyBtn').setAttribute('aria-label', d.copyLabel);
        document.querySelectorAll('.lang-btn').forEach((b) => b.classList.toggle('active', b.dataset.lang === l));
        try { localStorage.setItem('yapb-lang', l); } catch {}
        dispatchEvent(new Event('yapb-lang'));
      }
      (() => {
        let init = 'en';
        try {
          init = localStorage.getItem('yapb-lang')
            || ((navigator.language || 'en').toLowerCase().startsWith('ru') ? 'ru' : 'en');
        } catch {
          init = (navigator.language || 'en').toLowerCase().startsWith('ru') ? 'ru' : 'en';
        }
        applyLang(init);
        document.querySelectorAll('.lang-btn').forEach((b) =>
          b.addEventListener('click', () => applyLang(b.dataset.lang))
        );
      })();
    </script>

    <script is:inline>
      (() => {
        const btn = document.getElementById('dlBtn');
        const menu = document.getElementById('dlMenu');
        const listStable = document.getElementById('listStable');
        const listCont = document.getElementById('listCont');
        const verStable = document.getElementById('verStable');
        const verCont = document.getElementById('verCont');
        const status = document.getElementById('dlStatus');

        const L = {
          en: { live: 'Live versions from GitHub', offline: 'GitHub API unreachable — download via github.com', open: 'Open on GitHub →' },
          ru: { live: 'Версии с GitHub', offline: 'GitHub API недоступен — качайте с github.com', open: 'Открыть на GitHub →' },
        };
        const lang = () => (window.yapbLang === 'ru' ? 'ru' : 'en');
        let dlState = 'loading';
        addEventListener('yapb-lang', () => {
          if (dlState === 'live') status.textContent = L[lang()].live;
          else if (dlState === 'offline') { renderOffline(); status.textContent = L[lang()].offline; }
          paintCount();
          paintStars();
          paintForks();
        });

        // Fallback (cached) — matches current GitHub state, used if API is rate-limited
        const FALLBACK = {
          stable: {
            tag: '4.4.957',
            assets: [
              { name: 'yapb-4.4.957-windows.zip', size: 2050331, url: 'https://github.com/yapb/yapb/releases/download/4.4.957/yapb-4.4.957-windows.zip' },
              { name: 'yapb-4.4.957-windows.exe', size: 2291920, url: 'https://github.com/yapb/yapb/releases/download/4.4.957/yapb-4.4.957-windows.exe' },
              { name: 'yapb-4.4.957-linux.tar.xz', size: 1795296, url: 'https://github.com/yapb/yapb/releases/download/4.4.957/yapb-4.4.957-linux.tar.xz' },
              { name: 'yapb-4.4.957-extras.zip', size: 4341658, url: 'https://github.com/yapb/yapb/releases/download/4.4.957/yapb-4.4.957-extras.zip' },
            ],
          },
          cont: {
            tag: 'continuous',
            version: '4.5.1224',
            assets: [
              { name: 'yapb-4.5.1224-windows.zip', size: 2123026, url: 'https://github.com/yapb/yapb/releases/download/continuous/yapb-4.5.1224-windows.zip' },
              { name: 'yapb-4.5.1224-windows.exe', size: 2361864, url: 'https://github.com/yapb/yapb/releases/download/continuous/yapb-4.5.1224-windows.exe' },
              { name: 'yapb-4.5.1224-linux.tar.xz', size: 1869872, url: 'https://github.com/yapb/yapb/releases/download/continuous/yapb-4.5.1224-linux.tar.xz' },
              { name: 'yapb-4.5.1224-extras.zip', size: 6298398, url: 'https://github.com/yapb/yapb/releases/download/continuous/yapb-4.5.1224-extras.zip' },
            ],
          },
        };

        function kind(name) {
          const n = name.toLowerCase();
          if (n.endsWith('windows.exe')) return { label: 'Windows installer', order: 2 };
          if (n.includes('windows')) return { label: 'Windows', order: 1 };
          if (n.includes('linux')) return { label: 'Linux', order: 3 };
          if (n.includes('macos') || n.includes('darwin') || n.includes('osx')) return { label: 'macOS', order: 4 };
          if (n.includes('extras')) return { label: 'Extras', order: 5 };
          return { label: name, order: 9 };
        }

        function mb(size) {
          if (!size) return '';
          return (size / 1048576).toFixed(1) + ' MB';
        }

        function fmtDL(n) {
          if (n >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
          if (n >= 1e3) return (n / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
          return String(n);
        }

        function pluralDL(n) {
          const m10 = n % 10, m100 = n % 100;
          if (m10 === 1 && m100 !== 11) return 'загрузка';
          if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'загрузки';
          return 'загрузок';
        }

        let dlTotal = 0;
        function paintCount() {
          if (!dlTotal) return;
          document.getElementById('dlNum').textContent = '↓ ' + fmtDL(dlTotal);
          document.getElementById('dlLabel').textContent = lang() === 'ru' ? pluralDL(dlTotal) : 'downloads';
        }

        let starTotal = 0;
        function pluralStar(n) {
          const m10 = n % 10, m100 = n % 100;
          if (m10 === 1 && m100 !== 11) return 'звезда';
          if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'звезды';
          return 'звёзд';
        }
        function paintStars() {
          if (!starTotal) return;
          document.getElementById('starNum').textContent = fmtDL(starTotal);
          document.getElementById('starLabel').textContent = lang() === 'ru' ? pluralStar(starTotal) : 'stars';
          document.getElementById('dlStars').hidden = false;
        }
        let forkTotal = 0;
        function pluralFork(n) {
          const m10 = n % 10, m100 = n % 100;
          if (m10 === 1 && m100 !== 11) return 'форк';
          if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'форка';
          return 'форков';
        }
        function paintForks() {
          if (!forkTotal) return;
          document.getElementById('forkNum').textContent = fmtDL(forkTotal);
          document.getElementById('forkLabel').textContent = lang() === 'ru' ? pluralFork(forkTotal) : 'forks';
          document.getElementById('dlForks').hidden = false;
        }
        fetch('https://api.github.com/repos/yapb/yapb')
          .then((r) => {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then((j) => { starTotal = j.stargazers_count || 0; forkTotal = j.forks_count || 0; paintStars(); paintForks(); })
          .catch(() => {});

        function render(el, assets) {
          const sorted = [...assets].sort((a, b) => kind(a.name).order - kind(b.name).order);
          el.innerHTML = '';
          for (const a of sorted) {
            const k = kind(a.name);
            const link = document.createElement('a');
            link.href = a.url;
            link.rel = 'noopener';
            const left = document.createElement('span');
            left.textContent = k.label;
            const right = document.createElement('span');
            right.className = 'sz';
            right.textContent = mb(a.size);
            link.append(left, right);
            el.appendChild(link);
          }
        }

        function versionFromAssets(assets) {
          const m = (assets[0] && assets[0].name.match(/yapb-(.+?)-(windows|linux|macos|extras)/i)) || null;
          return m ? m[1] : '';
        }

        function renderOffline() {
          // api.github.com unreachable — just link out to github.com
          verStable.textContent = '';
          verCont.textContent = '';
          listStable.innerHTML = '';
          listCont.innerHTML = '';
          const s = document.createElement('a');
          s.href = 'https://github.com/yapb/yapb/releases/latest';
          s.rel = 'noopener';
          const sLeft = document.createElement('span');
          sLeft.textContent = L[lang()].open;
          s.append(sLeft);
          listStable.appendChild(s);
          const c = document.createElement('a');
          c.href = 'https://github.com/yapb/yapb/releases/tag/continuous';
          c.rel = 'noopener';
          const cLeft = document.createElement('span');
          cLeft.textContent = L[lang()].open;
          c.append(cLeft);
          listCont.appendChild(c);
        }

        function applyFallback() {
          verStable.textContent = FALLBACK.stable.tag;
          verCont.textContent = FALLBACK.cont.version;
          render(listStable, FALLBACK.stable.assets);
          render(listCont, FALLBACK.cont.assets);
        }

        applyFallback();

        fetch('https://api.github.com/repos/yapb/yapb/releases?per_page=100')
          .then((r) => {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then((releases) => {
            const cont = releases.find((r) => r.tag_name === 'continuous');
            const stable = releases.find((r) => !r.prerelease && r.tag_name !== 'continuous');
            if (cont && cont.assets && cont.assets.length) {
              const assets = cont.assets.map((a) => ({ name: a.name, size: a.size, url: a.browser_download_url }));
              verCont.textContent = versionFromAssets(assets) || cont.tag_name;
              render(listCont, assets);
            }
            if (stable && stable.assets && stable.assets.length) {
              const assets = stable.assets.map((a) => ({ name: a.name, size: a.size, url: a.browser_download_url }));
              verStable.textContent = stable.tag_name;
              render(listStable, assets);
            }
            dlState = 'live';
            status.textContent = L[lang()].live;
            dlTotal = releases.reduce(
              (s, r) => s + (r.assets || []).reduce((x, a) => x + (a.download_count || 0), 0),
              0
            );
            paintCount();
          })
          .catch(() => {
            renderOffline();
            dlState = 'offline';
            status.textContent = L[lang()].offline;
          });

        function toggle(force) {
          const open = force !== undefined ? force : menu.hidden;
          menu.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        }

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggle();
          const im = document.getElementById('instMenu');
          if (im && !menu.hidden) { im.hidden = true; document.getElementById('instBtn').setAttribute('aria-expanded', 'false'); }
        });
        document.addEventListener('click', (e) => {
          if (!menu.hidden && !document.getElementById('dl').contains(e.target)) toggle(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') toggle(false);
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const btn = document.getElementById('themeBtn');
        const meta = document.getElementById('themeColor');
        function paint() {
          const light = document.documentElement.dataset.theme === 'light';
          btn.textContent = light ? '☾' : '☀';
          if (meta) meta.setAttribute('content', light ? '#f4f1ea' : '#080a0d');
        }
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('yapb-theme', next); } catch {}
          paint();
          dispatchEvent(new Event('yapb-theme'));
        });
        paint();
      })();
    </script>

    <script is:inline>
      // Side particles (m18-style): particles flock into the soldier silhouette
      // sampled from /logo.png on each side, scatter from the cursor, reassemble.
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const TAU = Math.PI * 2;

        function palette() {
          const css = getComputedStyle(document.documentElement);
          const accent = css.getPropertyValue('--accent').trim() || '#ffb454';
          const muted = css.getPropertyValue('--muted').trim() || '#a8a29e';
          const light = document.documentElement.dataset.theme === 'light';
          return light ? [accent, accent, '#8a8177', '#e08a3c'] : [accent, accent, muted, '#ffd9a0'];
        }
        let PAL = palette();
        addEventListener('yapb-theme', () => {
          PAL = palette();
          if (reduced) systems.forEach(paint);
          else kick();
        });

        const mouse = { x: -9999, y: -9999 };
        addEventListener('pointermove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; kick(); }, { passive: true });
        document.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; kick(); });

        function drawFallback(c, S) {
          const TAU = Math.PI * 2;
          c.strokeStyle = '#fff'; c.fillStyle = '#fff'; c.lineCap = 'round';
          c.lineWidth = 13;
          c.beginPath(); c.arc(S / 2, S / 2, 76, 0, TAU); c.stroke();
          c.lineWidth = 11;
          const tick = (x1, y1, x2, y2) => { c.beginPath(); c.moveTo(x1, y1); c.lineTo(x2, y2); c.stroke(); };
          tick(S / 2, 10, S / 2, 54); tick(S / 2, S - 10, S / 2, S - 54);
          tick(10, S / 2, 54, S / 2); tick(S - 10, S / 2, S - 54, S / 2);
          c.beginPath(); c.arc(S / 2, S / 2, 9, 0, TAU); c.fill();
        }

        // Soldier silhouette sampled from /logo.png (fallback: crosshair)
        const logoImg = new Image();
        let logoState = 'loading'; // 'ready' | 'failed'
        logoImg.onload = () => { logoState = 'ready'; systems.forEach(relayout); kick(); };
        logoImg.onerror = () => { logoState = 'failed'; systems.forEach(relayout); kick(); };
        logoImg.src = '/logo.png';

        function buildPoints(W, H) {
          const S = 240;
          const off = document.createElement('canvas');
          off.width = S; off.height = S;
          const c = off.getContext('2d', { willReadFrequently: true });
          if (logoState === 'ready') {
            c.drawImage(logoImg, 0, 0, S, S);
          } else if (logoState === 'failed') {
            drawFallback(c, S);
          } else {
            return [];
          }
          const data = c.getImageData(0, 0, S, S).data;
          const k = (W * 0.82) / S;
          const ox = W * 0.09, oy = H / 2 - (S / 2) * k;
          let step = 4, pts = [];
          while (step <= 10) {
            pts = [];
            for (let y = 0; y < S; y += step) {
              for (let x = 0; x < S; x += step) {
                if (data[(y * S + x) * 4 + 3] > 128) pts.push([ox + x * k, oy + y * k]);
              }
            }
            if (pts.length <= 850) break;
            step++;
          }
          return pts;
        }

        const systems = [];
        // Static one-shot painter for prefers-reduced-motion: no rAF loop
        // there, so paint the assembled silhouette directly.
        function paint(sys) {
          if (!sys.w) return;
          const { ctx, parts } = sys;
          ctx.clearRect(0, 0, sys.w, sys.h);
          for (const p of parts) {
            ctx.fillStyle = PAL[p.ci % PAL.length];
            ctx.fillRect(p.x - p.s / 2, p.y - p.s / 2, p.s, p.s);
          }
        }
        function relayout(sys) {
          const r = sys.cv.getBoundingClientRect();
          if (!r.width || !r.height || getComputedStyle(sys.cv).display === 'none') { sys.w = 0; return; }
          const dpr = Math.min(devicePixelRatio || 1, 2);
          sys.w = r.width; sys.h = r.height;
          sys.cv.width = Math.round(r.width * dpr);
          sys.cv.height = Math.round(r.height * dpr);
          sys.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          sys.rect = r;
          sys.parts = buildPoints(sys.w, sys.h).map(([tx, ty]) => {
            const p = {
              tx, ty,
              x: Math.random() * sys.w, y: Math.random() * sys.h,
              vx: 0, vy: 0,
              s: 2 + Math.random() * 2.5,
              ci: (Math.random() * 4) | 0,
              ph: Math.random() * TAU,
              sp: 0.5 + Math.random(),
            };
            if (reduced) { p.x = tx; p.y = ty; }
            return p;
          });
          if (reduced) paint(sys);
        }

        // One-shot loop: runs only while particles are assembling or the
        // cursor is nearby. Settles → stops. Never restarts by itself.
        let raf = 0;
        function kick() {
          if (!raf && !reduced) raf = requestAnimationFrame(frame);
        }

        function frame() {
          let moving = false;
          for (const sys of systems) {
            if (!sys.w) continue;
            const { ctx, parts } = sys;
            ctx.clearRect(0, 0, sys.w, sys.h);
            const hov = mouse.x >= sys.rect.left - 120 && mouse.x <= sys.rect.left + sys.w + 120
              && mouse.y >= sys.rect.top - 120 && mouse.y <= sys.rect.top + sys.h + 120;
            if (hov) moving = true;
            const mx = mouse.x - sys.rect.left, my = mouse.y - sys.rect.top;
            for (const p of parts) {
              const dx = p.tx - p.x, dy = p.ty - p.y;
              const d = Math.hypot(dx, dy) || 1;
              const f = Math.min(d * 0.02, 2.2);
              p.vx += (dx / d) * f;
              p.vy += (dy / d) * f;
              const mdx = p.x - mx, mdy = p.y - my;
              const md = Math.hypot(mdx, mdy);
              if (md < 110 && md > 0.01) {
                const rf = (1 - md / 110) * 3.4;
                p.vx += (mdx / md) * rf;
                p.vy += (mdy / md) * rf;
              }
              p.vx *= 0.9; p.vy *= 0.9;
              p.x += p.vx; p.y += p.vy;
              ctx.fillStyle = PAL[p.ci % PAL.length];
              ctx.fillRect(p.x - p.s / 2, p.y - p.s / 2, p.s, p.s);
              if (Math.hypot(p.vx, p.vy) > 0.15 || Math.hypot(p.tx - p.x, p.ty - p.y) > 1) moving = true;
            }
          }
          raf = 0;
          if (moving && !reduced) raf = requestAnimationFrame(frame);
        }

        for (const id of ['sideL', 'sideR']) {
          const cv = document.getElementById(id);
          if (!cv) continue;
          const sys = { cv, ctx: cv.getContext('2d'), parts: [], w: 0, h: 0, rect: null };
          systems.push(sys);
          relayout(sys);
        }
        let rT;
        addEventListener('resize', () => {
          clearTimeout(rT);
          rT = setTimeout(() => { systems.forEach(relayout); kick(); }, 150);
        });
        // Styles may still be loading when this inline script first measures
        // the canvases, so re-measure once everything (CSS, logo) is in place.
        addEventListener('load', () => { systems.forEach(relayout); kick(); }, { once: true });
        requestAnimationFrame(frame);
      })();
    </script>

    <script is:inline>
      (() => {
        const modal = document.getElementById('licModal');
        const openBtn = document.getElementById('licBtn');
        const closeBtn = document.getElementById('licClose');
        let lastFocus = null;
        function open() {
          lastFocus = document.activeElement;
          modal.hidden = false;
          document.body.style.overflow = 'hidden';
          closeBtn.focus();
        }
        function close() {
          modal.hidden = true;
          document.body.style.overflow = '';
          if (lastFocus) lastFocus.focus();
        }
        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        modal.addEventListener('click', (e) => { if (e.target.hasAttribute('data-close')) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });
      })();
    </script>

    <script is:inline>
      (() => {
        const btn = document.getElementById('codeBtn');
        const menu = document.getElementById('codeMenu');
        function toggle(force) {
          const open = force !== undefined ? force : menu.hidden;
          menu.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        }
        btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
        document.addEventListener('click', (e) => {
          if (!menu.hidden && !document.getElementById('codeDrop').contains(e.target)) toggle(false);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });
      })();
    </script>

    <script is:inline>
      // Install dropdown: toggle + copy button
      (() => {
        const instBtn = document.getElementById('instBtn');
        const instMenu = document.getElementById('instMenu');
        const dlMenu = document.getElementById('dlMenu');
        const dlBtn = document.getElementById('dlBtn');
        function toggleInst(force) {
          const open = force !== undefined ? force : instMenu.hidden;
          instMenu.hidden = !open;
          instBtn.setAttribute('aria-expanded', String(open));
          if (open) { dlMenu.hidden = true; dlBtn.setAttribute('aria-expanded', 'false'); }
        }
        instBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleInst(); });
        document.addEventListener('click', (e) => {
          if (!instMenu.hidden && !document.getElementById('inst').contains(e.target)) toggleInst(false);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggleInst(false); });

        const code = document.getElementById('instCode');
        const copy = document.getElementById('copyBtn');
        copy.addEventListener('click', async () => {
          const text = code.textContent;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch {}
            ta.remove();
          }
          const old = copy.textContent;
          copy.textContent = '✓';
          setTimeout(() => { copy.textContent = old; }, 1200);
        });
      })();
    </script>
  </body>
</html>
