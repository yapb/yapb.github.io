          download: 'Download',
          install: 'Install',
          grpStable: 'Stable',
          grpCont: 'Continuous',
          beta: 'beta',
          dlLoading: 'Loading live versions from GitHub…',
          allReleases: 'All releases →',
          footerLeft: 'YaPB — open-source Counter-Strike bot.',
          soon: 'soon',
          disclaimer: 'Not affiliated with Valve Corporation. Counter-Strike and Condition Zero are registered trademarks of Valve Corporation. Get the game on',
          title: 'YaPB — The Counter-Strike Bot',
          metaDesc: 'YaPB is an open-source bot for Counter-Strike 1.6 and Condition Zero. Download the latest release, grab waypoints, read the docs.',
